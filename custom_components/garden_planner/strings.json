{
  "config": {
    "step": {
      "user": {
        "title": "Set up Garden Planner",
        "description": "Create your garden. Afterwards, add garden beds and plantings, and adjust the plant-data provider and frost dates from the integration's options."
      }
    },
    "abort": {
      "already_configured": "Garden Planner is already set up."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Garden settings",
        "description": "Frost dates are estimated from your Home Assistant location. Leave the override fields empty to keep using the estimate.",
        "data": {
          "provider": "Plant data provider",
          "api_key": "API key (Perenual only)",
          "units": "Units",
          "last_frost": "Last spring frost (override)",
          "first_frost": "First fall frost (override)"
        }
      }
    }
  },
  "config_subentries": {
    "bed": {
      "initiate_flow": {
        "user": "Add garden bed",
        "reconfigure": "Reconfigure garden bed"
      },
      "entry_type": "Garden bed",
      "step": {
        "user": {
          "title": "Add garden bed",
          "data": {
            "name": "Name",
            "bed_type": "Type of bed",
            "sun_exposure": "Sun exposure",
            "length_ft": "Length (ft)",
            "width_ft": "Width (ft)",
            "soil": "Soil type",
            "notes": "Notes"
          }
        },
        "reconfigure": {
          "title": "Reconfigure garden bed",
          "data": {
            "name": "Name",
            "bed_type": "Type of bed",
            "sun_exposure": "Sun exposure",
            "length_ft": "Length (ft)",
            "width_ft": "Width (ft)",
            "soil": "Soil type",
            "notes": "Notes"
          }
        }
      }
    },
    "planting": {
      "initiate_flow": {
        "user": "Add planting"
      },
      "entry_type": "Planting",
      "step": {
        "user": {
          "title": "Add planting",
          "description": "Choose a bed and search for a plant.",
          "data": {
            "bed_id": "Garden bed",
            "plant_query": "Search for a plant",
            "method": "Sowing method (optional override)",
            "quantity": "Quantity",
            "season_year": "Season year",
            "successions": "Number of successive plantings",
            "succession_interval_days": "Days between successions"
          }
        },
        "pick": {
          "title": "Choose a plant",
          "description": "{note}",
          "data": {
            "plant_source_id": "Plant"
          }
        }
      },
      "abort": {
        "no_beds": "Add at least one garden bed before adding a planting.",
        "no_matches": "No plants matched your search. Try a different term or provider."
      }
    }
  },
