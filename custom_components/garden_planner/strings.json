  "services": {
    "log_action": {
      "name": "Log action",
      "description": "Record that you performed an action on a planting.",
      "fields": {
        "device_id": {
          "name": "Planting",
          "description": "The planting(s) to log the action against."
        },
        "kind": {
          "name": "Action",
          "description": "What you did."
        },
        "date": {
          "name": "Date",
          "description": "When it happened. Defaults to today."
        }
      }
    },
    "set_frost_dates": {
      "name": "Set frost dates",
      "description": "Override the estimated frost dates.",
      "fields": {
        "last_frost": {
          "name": "Last spring frost",
          "description": "Average date of the last spring frost."
        },
        "first_frost": {
          "name": "First fall frost",
          "description": "Average date of the first fall frost."
        }
      }
    },
    "refresh_plant_data": {
      "name": "Refresh plant data",
      "description": "Re-fetch plant profiles for all plantings from the configured provider."
    },
    "archive_planting": {
      "name": "Archive planting",
      "description": "Save a finished planting's season summary and history to the archive, then remove it.",
      "fields": {
        "device_id": {
          "name": "Planting",
          "description": "The planting(s) to archive."
        }
      }
    },
    "clone_to_next_season": {
      "name": "Clone to next season",
      "description": "Duplicate a planting into the following year with a fresh, empty history.",
      "fields": {
        "device_id": {
          "name": "Planting",
          "description": "The planting(s) to clone."
        }
      }
    }
